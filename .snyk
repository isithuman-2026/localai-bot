# Snyk (https://snyk.io) policy file
# Ignores OS-level Debian 13 container vulns with no upstream fix and no known exploit.
# apt-get upgrade in Dockerfile will auto-apply patches when Debian releases them.
version: v1.25.0
ignore:
  # chromadb (CVE-2026-45829..45833): no fixed version in any release as of 2026-07-02.
  # All five target Chroma's server API (auth bypass, deserialization). This bot uses
  # in-process EphemeralClient only; no Chroma server runs or is exposed. Revisit when
  # a fixed release ships.
  SNYK-PYTHON-CHROMADB-16758047:
    - '*':
        reason: Server-API vuln; bot uses in-process EphemeralClient, no server exposed. No fixed version available.
        expires: '2027-01-01T00:00:00.000Z'
  SNYK-PYTHON-CHROMADB-17337041:
    - '*':
        reason: Server-API vuln; bot uses in-process EphemeralClient, no server exposed. No fixed version available.
        expires: '2027-01-01T00:00:00.000Z'
